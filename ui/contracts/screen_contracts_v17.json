{
  "contract_version": "17.0.0",
  "rule": "The frontend projects backend state; it never infers institutional or financial truth.",
  "surfaces": [
    {
      "id": "fund-command",
      "purpose": "Allocate attention across live investment situations.",
      "inputs": ["fund.morning_delta[]", "fund.situations[]", "role_projection"],
      "allowed_actions": ["select_situation", "open_deal_world", "switch_role"],
      "must_not": ["rank situations without a backend reason", "change case facts by role"]
    },
    {
      "id": "deal-command",
      "purpose": "Orient the user in one persistent investment case.",
      "inputs": ["question_spine[]", "branches", "morning_delta", "next_best_work"],
      "allowed_actions": ["open_question", "open_room", "open_change_review"],
      "must_not": ["derive strength or economics locally"]
    },
    {
      "id": "object-aperture",
      "purpose": "Inspect basis, dependents, action and history without losing place.",
      "inputs": ["object", "support_routes", "provenance", "dependencies", "history"],
      "allowed_actions": ["open_source", "comment", "dispatch_work"],
      "must_not": ["hide uncertainty", "promote a claim to a position"]
    },
    {
      "id": "change-review",
      "purpose": "Admit or reject a proposed interpretation before propagation.",
      "inputs": ["source_passage", "applicability", "proposed_position", "event"],
      "allowed_actions": ["review_source", "edit_treatment", "admit_event"],
      "must_not": ["mutate Current or Approved directly"]
    },
    {
      "id": "change-impact",
      "purpose": "Reveal ordered consequences returned by the Transition Engine.",
      "inputs": ["affected_set[]", "recomputed_values[]", "unchanged_objects[]", "coverage_limits[]"],
      "allowed_actions": ["replay_transition", "continue_to_action"],
      "must_not": ["invent dispositions", "recompute formulas in the browser"]
    },
    {
      "id": "decision-room",
      "purpose": "Resolve one formal authority request.",
      "inputs": ["human_stop", "evidence_for", "evidence_against", "courses", "authority_rule"],
      "allowed_actions": ["select_course", "attest_decision"],
      "must_not": ["approve without an authority record"]
    },
    {
      "id": "execution-room",
      "purpose": "Cross the externality boundary only after authority and checks.",
      "inputs": ["execution_package", "recipient", "checks", "authority_record"],
      "allowed_actions": ["preview", "execute_or_simulate"],
      "must_not": ["send in demo mode", "execute without authority"]
    },
    {
      "id": "causal-replay",
      "purpose": "Reconstruct what was known, believed, approved and open at a point in time.",
      "inputs": ["bitemporal_snapshot", "history", "replay_hash"],
      "allowed_actions": ["select_snapshot", "inspect_object"],
      "must_not": ["rewrite historical Approved state"]
    }
  ]
}
