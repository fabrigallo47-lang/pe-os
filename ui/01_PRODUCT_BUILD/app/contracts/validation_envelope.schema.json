{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://panta.local/contracts/validation_envelope.schema.json",
  "title": "PANTA V20 Technical Validation Envelope",
  "type": "object",
  "properties": {
    "validation_envelope_id": {
      "type": "string",
      "minLength": 1
    },
    "id": {
      "type": "string"
    },
    "label": {
      "type": "string",
      "minLength": 1
    },
    "question_id": {
      "type": "string",
      "minLength": 1
    },
    "target_class": {
      "type": "string",
      "minLength": 1
    },
    "environment": {
      "type": "string",
      "minLength": 1
    },
    "configuration": {
      "type": "string",
      "minLength": 1
    },
    "detection_range_m": {
      "anyOf": [
        {
          "type": "number"
        },
        {
          "type": "null"
        }
      ]
    },
    "classification_range_m": {
      "anyOf": [
        {
          "type": "number"
        },
        {
          "type": "null"
        }
      ]
    },
    "false_positive_rate": {
      "anyOf": [
        {
          "type": "number"
        },
        {
          "type": "null"
        }
      ]
    },
    "false_negative_rate": {
      "anyOf": [
        {
          "type": "number"
        },
        {
          "type": "null"
        }
      ]
    },
    "test_status": {
      "type": "string",
      "minLength": 1
    },
    "evidence_claim_ids": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "coverage_status": {
      "type": "string",
      "minLength": 1
    },
    "effective_date": {
      "type": "string",
      "format": "date"
    },
    "known_at": {
      "type": "string",
      "format": "date-time"
    }
  },
  "additionalProperties": true,
  "required": [
    "validation_envelope_id",
    "label",
    "question_id",
    "target_class",
    "environment",
    "configuration",
    "test_status",
    "evidence_claim_ids",
    "coverage_status",
    "effective_date",
    "known_at"
  ]
}
