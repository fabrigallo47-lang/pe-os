        "statement": {
          "type": "string",
          "minLength": 1
        },
        "source_id": {
          "type": "string",
          "minLength": 1
        },
        "locator": {
          "type": "string"
        },
        "epistemic_class": {
          "enum": [
            "asserted",
            "observed",
            "derived",
            "attested",
            "institutional_act"
          ]
        },
        "value": {
          "type": [
            "string",
            "number",
            "integer",
            "boolean",
            "null",
            "object",
            "array"
          ]
