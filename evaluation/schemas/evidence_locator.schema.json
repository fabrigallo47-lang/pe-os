{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://panta.local/evaluation/evidence_locator.schema.json",
  "title": "PANTA Evaluation Evidence Locator",
  "oneOf": [
    {
      "type": "object",
      "additionalProperties": false,
      "required": ["type", "page"],
      "properties": {
        "type": {"const": "page"},
        "page": {"type": "integer", "minimum": 0},
        "index_base": {"enum": [0, 1]},
        "bbox": {"$ref": "#/$defs/bbox"}
      }
    },
    {
      "type": "object",
      "additionalProperties": false,
      "required": ["type", "slide"],
      "properties": {
        "type": {"const": "slide"},
        "slide": {"type": "integer", "minimum": 1},
        "bbox": {"$ref": "#/$defs/bbox"}
      }
    },
    {
      "type": "object",
      "additionalProperties": false,
      "required": ["type", "sheet", "range"],
      "properties": {
        "type": {"const": "cell"},
        "sheet": {"type": "string", "minLength": 1},
        "range": {"type": "string", "minLength": 1}
      }
    },
    {
      "type": "object",
      "additionalProperties": false,
      "required": ["type"],
      "properties": {
        "type": {"const": "word"},
        "section": {"type": "string"},
        "paragraph": {"type": "integer", "minimum": 0},
        "table": {"type": "integer", "minimum": 0},
        "row": {"type": "integer", "minimum": 0},
        "column": {"type": "integer", "minimum": 0}
      },
      "anyOf": [
        {"required": ["section"]},
        {"required": ["paragraph"]},
        {"required": ["table"]}
      ]
    },
    {
      "type": "object",
      "additionalProperties": false,
      "required": ["type", "part"],
      "properties": {
        "type": {"const": "email_part"},
        "part": {"enum": ["headers", "subject", "body_text", "body_html", "body", "attachment", "inline_image"]},
        "message_id": {"type": "string"},
        "attachment_name": {"type": "string"}
      }
    },
    {
      "type": "object",
      "additionalProperties": false,
      "required": ["type", "message"],
      "properties": {
        "type": {"const": "message"},
        "message": {"type": "integer", "minimum": 0},
        "message_id": {"type": "string"},
        "speaker": {"type": "string"}
      }
    },
    {
      "type": "object",
      "additionalProperties": false,
      "required": ["type", "attachment_name"],
      "properties": {
        "type": {"const": "attachment"},
        "attachment_name": {"type": "string", "minLength": 1},
        "parent_input_id": {"type": "string"}
      }
    },
    {
      "type": "object",
      "additionalProperties": false,
      "required": ["type", "bbox"],
      "properties": {
        "type": {"const": "image_region"},
        "page": {"type": "integer", "minimum": 0},
        "slide": {"type": "integer", "minimum": 1},
        "image_id": {"type": "string"},
        "bbox": {"$ref": "#/$defs/bbox"}
      }
    },
    {
      "type": "object",
      "additionalProperties": false,
      "required": ["type", "start_ms", "end_ms"],
      "properties": {
        "type": {"const": "timecode"},
        "start_ms": {"type": "integer", "minimum": 0},
        "end_ms": {"type": "integer", "minimum": 0}
      }
    },
    {
      "type": "object",
      "additionalProperties": false,
      "required": ["type", "value"],
      "properties": {
        "type": {"const": "generic"},
        "value": {"type": "string", "minLength": 1}
      }
    }
  ],
  "$defs": {
    "bbox": {
      "type": "array",
      "prefixItems": [
        {"type": "number"},
        {"type": "number"},
        {"type": "number"},
        {"type": "number"}
      ],
      "items": false,
      "minItems": 4,
      "maxItems": 4
    }
  }
}
