      }
    },
    "actor_directory": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/actor"
      }
    },
    "context": {
      "type": "object",
      "properties": {},
      "additionalProperties": true
    },
    "v16": {
      "type": "object",
      "properties": {},
      "additionalProperties": true
    },
    "epistemic_vocabulary": {
      "type": "object",
      "properties": {},
      "additionalProperties": true
    }
