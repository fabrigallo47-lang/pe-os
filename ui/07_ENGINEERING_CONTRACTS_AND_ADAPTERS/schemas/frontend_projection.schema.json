        "label": {
          "type": "string",
          "minLength": 1
        },
        "detail": {
          "type": "string"
        },
        "actor_id": {
          "type": "string",
          "minLength": 1
        },
        "actor_label": {
          "type": "string"
        },
        "object_id": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ]
        },
        "case_id": {
          "type": "string",
          "minLength": 1
