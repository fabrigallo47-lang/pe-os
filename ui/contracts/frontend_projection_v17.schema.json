{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "panta://contracts/frontend_projection_v17.schema.json",
  "title": "PANTA V17 Frontend Projection",
  "type": "object",
  "required": [
    "schema_version",
    "package_version",
    "fund",
    "deal",
    "events"
  ],
  "properties": {
    "schema_version": {
      "const": "frontend-projection/1.0"
    },
    "package_version": {
      "type": "string"
    },
    "disclosure": {
      "type": "string"
    },
    "fund": {
      "type": "object",
      "required": [
        "id",
        "name",
        "morning_delta",
        "situations"
      ],
      "properties": {
        "name": {
          "type": "string"
        },
        "morning_delta": {
          "type": "array",
          "items": {
            "type": "object"
          }
        },
        "situations": {
          "type": "array",
          "items": {
            "type": "object",
            "required": [
              "id",
              "case_id",
              "company",
              "title",
              "status"
            ]
          }
        },
        "id": {
          "type": "string"
        },
        "date": {
          "type": "string"
        }
      },
      "additionalProperties": true
    },
    "deal": {
      "type": "object",
      "required": [
        "case_id",
        "name",
        "question_spine",
        "rooms",
        "scenarioLab",
        "decisionRoom",
        "executionRoom",
        "replay"
      ],
      "properties": {
        "case_id": {
          "type": "string"
        },
        "name": {
          "type": "string"
        },
        "question_spine": {
          "type": "array"
        },
        "rooms": {
          "type": "object"
        },
        "scenarioLab": {
          "type": "object"
        },
        "decisionRoom": {
          "type": "object"
        },
        "executionRoom": {
          "type": "object"
        },
        "replay": {
          "type": "object"
        }
      },
      "additionalProperties": true
    },
    "events": {
      "type": "object",
      "additionalProperties": {
        "$ref": "#/$defs/eventProjection"
      }
    }
  },
  "$defs": {
    "eventProjection": {
      "type": "object",
      "required": [
        "event_id",
        "label",
        "source_title",
        "source_passage",
        "locator",
        "definition",
        "period",
        "perimeter",
        "proposed_position"
      ],
      "properties": {
        "event_id": {
          "type": "string"
        },
        "label": {
          "type": "string"
        },
        "source_title": {
          "type": "string"
        },
        "source_passage": {
          "type": "string"
        },
        "locator": {
          "type": "string"
        },
        "definition": {
          "type": "string"
        },
        "period": {
          "type": "string"
        },
        "perimeter": {
          "type": "string"
        },
        "proposed_position": {
          "type": "string"
        },
        "synthetic": {
          "type": "boolean"
        }
      },
      "additionalProperties": true
    }
  },
  "additionalProperties": false
}