{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://panta.local/contracts/lens.schema.json",
  "title": "PANTA V20 Governed Lens",
  "type": "object",
  "properties": {
    "lens_id": {
      "type": "string",
      "minLength": 1
    },
    "id": {
      "type": "string"
    },
    "label": {
      "type": "string",
      "minLength": 1
    },
    "description": {
      "type": "string"
    },
    "ranking_weights": {
      "type": "object",
      "additionalProperties": {
        "type": "number"
      }
    },
    "question_order": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "required_question_ids": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "materiality_policy_id": {
      "type": "string"
    },
    "authority_policy_id": {
      "type": "string"
    },
    "controls": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "effective_date": {
      "type": "string",
      "format": "date"
    },
    "known_at": {
      "type": "string",
      "format": "date-time"
    }
  },
  "additionalProperties": true,
  "required": [
    "lens_id",
    "label",
    "ranking_weights",
    "question_order",
    "required_question_ids",
    "effective_date",
    "known_at"
  ]
}
