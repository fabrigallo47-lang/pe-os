        "active_lens_id": {
          "type": [
            "string",
            "null"
          ]
        },
        "lenses": {
          "type": "array",
          "items": {
            "$ref": "https://panta.local/contracts/lens.schema.json"
          }
        },
        "participants": {
          "type": "array",
          "items": {
            "$ref": "https://panta.local/contracts/participant.schema.json"
          }
        },
        "interactions": {
          "type": "array",
          "items": {
            "$ref": "https://panta.local/contracts/interaction.schema.json"
          }
        },
        "utterances": {
          "type": "array",
          "items": {
            "$ref": "https://panta.local/contracts/utterance.schema.json"
          }
        },
        "derivation_specs": {
          "type": "array",
          "items": {
            "$ref": "https://panta.local/contracts/derivation_spec.schema.json"
          }
        },
        "derivations": {
          "type": "array",
          "items": {
            "$ref": "https://panta.local/contracts/derivation.schema.json"
          }
        },
        "discrepancy_rules": {
          "type": "array",
          "items": {
            "$ref": "https://panta.local/contracts/discrepancy_rule.schema.json"
          }
        },
        "discrepancy_candidates": {
          "type": "array",
          "items": {
            "$ref": "https://panta.local/contracts/discrepancy_candidate.schema.json"
          }
        },
        "hypotheses": {
          "type": "array",
          "items": {
            "$ref": "https://panta.local/contracts/hypothesis.schema.json"
          }
        },
        "agent_missions": {
          "type": "array",
          "items": {
            "$ref": "https://panta.local/contracts/agent_mission.schema.json"
          }
        },
        "spine_change_proposals": {
          "type": "array",
          "items": {
            "$ref": "https://panta.local/contracts/spine_change_proposal.schema.json"
          }
        },
        "condition_edges": {
          "type": "array",
          "items": {
            "$ref": "https://panta.local/contracts/condition_edge.schema.json"
          }
        },
        "validation_envelopes": {
          "type": "array",
          "items": {
            "$ref": "https://panta.local/contracts/validation_envelope.schema.json"
          }
        },
        "venture_financing": {
          "anyOf": [
