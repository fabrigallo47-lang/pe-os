        "effective_date": {
          "type": "string",
          "format": "date"
        },
        "known_at": {
          "type": "string",
          "format": "date-time"
        }
      },
      "additionalProperties": true,
      "required": [
        "event_id",
        "type",
        "label",
        "effective_date",
        "known_at"
      ]
