      "type": "object",
      "properties": {
        "actor_id": {
          "type": "string",
          "minLength": 1
        },
        "name": {
          "type": "string"
        },
        "display_name": {
          "type": "string"
        },
        "role": {
          "type": "string",
          "minLength": 1
        },
        "authority_verbs": {
          "type": "array",
          "items": {
            "type": "string"
          }
        }
      },
      "additionalProperties": true,
      "required": [
        "actor_id",
        "role",
        "authority_verbs"
      ]
