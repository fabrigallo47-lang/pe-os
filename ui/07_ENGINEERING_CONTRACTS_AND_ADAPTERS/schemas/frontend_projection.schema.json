        "believed": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "approved": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "open": {
          "type": "array",
          "items": {
            "type": "string"
          }
