          "status": {
            "type": "string",
            "minLength": 1
          },
          "reason_code": {
            "type": "string"
          }
        },
        "additionalProperties": true,
        "required": [
          "check_id",
          "status"
        ]
      }
    },
    "candidate_current_approved_delta": {
      "type": "object",
      "properties": {
        "candidate": {
          "type": [
            "object",
            "array"
          ],
          "items": {
            "type": "object",
            "additionalProperties": true
          },
          "properties": {
            "state_id": {
              "type": "string",
              "minLength": 1
            },
            "status": {
              "type": "string",
              "minLength": 1
            }
          },
          "additionalProperties": true,
          "required": [
            "state_id",
            "status"
          ]
        },
        "current": {
          "type": [
            "object",
            "array"
          ],
          "items": {
            "type": "object",
            "additionalProperties": true
          },
          "properties": {
            "state_id": {
              "type": "string",
              "minLength": 1
            },
            "status": {
              "type": "string",
              "minLength": 1
            },
            "mutation": {
              "type": "string"
            }
          },
          "additionalProperties": true,
          "required": [
            "state_id",
            "status"
          ]
        },
        "approved": {
          "type": [
            "object",
            "array"
          ],
          "items": {
            "type": "object",
            "additionalProperties": true
          },
          "properties": {
            "state_id": {
              "type": "string",
              "minLength": 1
            },
            "status": {
              "type": "string",
              "minLength": 1
            }
          },
          "additionalProperties": true,
          "required": [
            "state_id",
            "status"
          ]
        }
      },
      "additionalProperties": true,
      "required": [
        "candidate",
        "current",
        "approved"
      ]
    },
    "partial_settlement_status": {
      "type": "object",
      "properties": {
        "candidate": {
          "type": "string",
          "minLength": 1
        },
        "current": {
          "type": "string",
          "minLength": 1
        },
        "approved": {
          "type": "string",
          "minLength": 1
        }
      },
      "additionalProperties": true,
      "required": [
        "candidate",
        "current",
        "approved"
      ]
    },
    "replay_hash": {
      "type": "string",
      "minLength": 1
    },
    "candidate_state_id": {
      "type": "string",
      "minLength": 1
    },
    "as_of_state_id": {
      "type": "string"
    },
    "as_of_date": {
      "type": "string",
      "format": "date"
    },
    "projection_id": {
      "type": "string"
    },
    "status": {
      "type": "string"
    },
    "artifact_change_sets": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "artifact_id": {
            "type": "string",
            "minLength": 1
          },
          "title": {
            "type": "string",
            "minLength": 1
          },
          "version_before": {
            "type": "string"
          },
          "version_after": {
            "type": "string"
          },
          "status": {
            "type": "string",
            "minLength": 1
          },
          "changes": {
            "type": "array",
            "items": {
              "type": "object",
              "properties": {
                "label": {
                  "type": "string"
                },
                "sheet": {
                  "type": "string"
                },
                "cell": {
                  "type": "string"
                },
                "before": {
                  "type": [
                    "string",
                    "number",
                    "integer",
                    "boolean",
                    "null",
                    "object",
                    "array"
                  ]
                },
                "after": {
                  "type": [
                    "string",
                    "number",
                    "integer",
                    "boolean",
                    "null",
                    "object",
                    "array"
                  ]
                },
                "trace_id": {
                  "type": "string"
                }
              },
              "additionalProperties": true
            }
          },
          "passage_before": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ]
          },
          "passage_after": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ]
          }
        },
        "additionalProperties": true,
        "required": [
          "artifact_id",
          "title",
          "status"
        ]
      }
    },
    "change_sets": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": true
      }
    },
    "policy_result": {
      "type": "object",
      "properties": {},
      "additionalProperties": true
    },
    "materiality_assessment": {
      "type": "object",
      "additionalProperties": true
    },
    "authority_resolution": {
      "type": "object",
      "additionalProperties": true
    },
    "governance": {
      "type": "object",
      "additionalProperties": true
    },
    "effective_date": {
      "type": "string",
      "format": "date"
    },
    "known_at": {
      "type": "string",
      "format": "date-time"
    }
  },
  "additionalProperties": true,
  "required": [
    "schema_version",
    "engine_version",
    "run_id",
    "case_id",
    "prior_state_id",
    "policy_refs",
    "affected_set",
    "ordered_transitions",
    "rule_switches",
    "recomputed_values",
    "unchanged_objects",
    "human_stops",
    "blocked_components",
    "coverage_limits",
    "invariant_checks",
    "candidate_current_approved_delta",
    "partial_settlement_status",
    "replay_hash",
    "source_event_id"
  ]
}
