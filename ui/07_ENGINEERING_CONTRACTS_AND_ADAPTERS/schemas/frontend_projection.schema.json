      "required": [
        "case_id",
        "objective",
        "as_of_state_id",
        "as_of_date",
        "projection_id",
        "question_spine",
        "artifacts",
        "claims",
        "rooms",
        "replay",
        "source_center",
        "temporal",
        "archetype",
        "lenses",
        "participants",
        "interactions",
        "utterances",
        "derivation_specs",
        "derivations",
        "discrepancy_rules",
        "discrepancy_candidates",
        "hypotheses",
        "agent_missions",
        "spine_change_proposals",
        "condition_edges",
        "validation_envelopes"
      ]
    },
    "events": {
      "type": "object",
