    "source_event": {
      "type": "object",
      "properties": {
        "event_id": {
          "type": "string",
          "minLength": 1
        },
        "type": {
          "type": "string",
          "minLength": 1
        },
        "label": {
          "type": "string",
          "minLength": 1
        },
        "source_title": {
          "type": "string"
        },
        "source_passage": {
          "type": "string"
        },
        "locator": {
          "type": "string"
        },
        "definition": {
          "type": "string"
        },
        "period": {
          "type": "string"
        },
        "perimeter": {
          "type": "string"
        },
        "proposed_position": {
          "type": "string"
        },
        "scene_id": {
          "type": "string"
