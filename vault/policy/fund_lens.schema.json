{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://panta.local/schemas/fund_lens.schema.json",
  "title": "PANTA Fund Lens",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "lens_id",
    "version",
    "label",
    "description",
    "archetype",
    "binding_profile",
    "binding_config",
    "effective_date",
    "questions"
  ],
  "properties": {
    "schema_version": {"const": "fund-lens/1.0"},
    "lens_id": {"type": "string", "pattern": "^[A-Za-z0-9._-]+$"},
    "version": {"type": "string", "pattern": "^[0-9]+\\.[0-9]+\\.[0-9]+$"},
    "label": {"type": "string", "minLength": 1},
    "description": {"type": "string"},
    "archetype": {"type": "string", "minLength": 1},
    "binding_profile": {"type": "string", "pattern": "^[A-Za-z0-9._-]+$"},
    "binding_config": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "schema_version",
        "permitted_question_ids",
        "metric_rules",
        "keyword_rules"
      ],
      "properties": {
        "schema_version": {"const": "binding-config/1.0"},
        "permitted_question_ids": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": {"$ref": "#/$defs/questionId"}
        },
        "metric_rules": {
          "type": "array",
          "items": {"$ref": "#/$defs/metricRule"}
        },
        "keyword_rules": {
          "type": "array",
          "items": {"$ref": "#/$defs/keywordRule"}
        }
      }
    },
    "effective_date": {"type": "string", "format": "date"},
    "questions": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["id", "version", "workstream", "title"],
        "properties": {
          "id": {"$ref": "#/$defs/questionId"},
          "version": {"type": "integer", "minimum": 1},
          "workstream": {"type": "string", "minLength": 1},
          "title": {"type": "string", "minLength": 1}
        }
      }
    }
  },
  "$defs": {
    "questionId": {
      "type": "string",
      "pattern": "^[A-Za-z0-9._:-]+$"
    },
    "ruleQuestionIds": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": {"$ref": "#/$defs/questionId"}
    },
    "confidence": {
      "type": "number",
      "minimum": 0,
      "maximum": 1
    },
    "rank": {
      "type": "integer",
      "minimum": 0
    },
    "metricRule": {
      "type": "object",
      "additionalProperties": false,
      "required": ["aliases", "question_ids", "confidence", "rank"],
      "properties": {
        "aliases": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": {"type": "string", "minLength": 1}
        },
        "question_ids": {"$ref": "#/$defs/ruleQuestionIds"},
        "confidence": {"$ref": "#/$defs/confidence"},
        "rank": {"$ref": "#/$defs/rank"}
      }
    },
    "keywordRule": {
      "type": "object",
      "additionalProperties": false,
      "required": ["pattern", "question_ids", "confidence", "rank"],
      "properties": {
        "pattern": {"type": "string", "minLength": 1},
        "question_ids": {"$ref": "#/$defs/ruleQuestionIds"},
        "confidence": {"$ref": "#/$defs/confidence"},
        "rank": {"$ref": "#/$defs/rank"}
      }
    }
  }
}
