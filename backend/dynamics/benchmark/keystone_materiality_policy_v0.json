{
  "schema_version": "runtime-policy-1.0",
  "policy_id": "KEYSTONE-MATERIALITY-V0",
  "version": "0.4.0",
  "status": "SYNTHETIC_TEST_FIXTURE",
  "canonical_ontology_version": "1.1.0",
  "scope": {
    "case_id": "KEYSTONE-CIC",
    "purpose": "State Transition Engine conformance testing",
    "universal_panta_rule": false,
    "final_fund_lens": false
  },
  "kernel_invariants": {
    "compute_full_affected_set_before_materiality": true,
    "propagate_every_non_equivalent_change_in_candidate": true,
    "materiality_may_prune_computation": false,
    "severity_aggregation": "MAX",
    "severity_order": [
      "M0_LOCAL",
      "M1_PROFESSIONAL_REVIEW",
      "M2_GATE_AUTHORITY",
      "M3_HARD_BLOCKER"
    ]
  },
  "semantic_preconditions": {
    "required_dimensions": [
      "definition",
      "period",
      "perimeter"
    ],
    "exact_or_explicit_compatibility_mapping_required": true,
    "ambiguous_mapping_result": "HUMAN_STOP",
    "unambiguous_mismatch_result": "NON_APPLICABLE",
    "equivalence_before_materiality": true
  },
  "classes": [
    {
      "class": "M0_LOCAL",
      "rank": 0,
      "meaning": "Deterministic local recalculation or reconciliation with audit and no professional judgment.",
      "default_treatment": "AUTO_RECONCILE_IF_GUARDS_PASS"
    },
    {
      "class": "M1_PROFESSIONAL_REVIEW",
      "rank": 1,
      "meaning": "Analytical treatment or Case Position adoption requires a qualified professional reviewer.",
      "default_treatment": "CURRENT_REVIEW_REQUIRED"
    },
    {
      "class": "M2_GATE_AUTHORITY",
      "rank": 2,
      "meaning": "A gate, delegated limit, reserved decision or authority verb is affected.",
      "default_treatment": "AUTHORITY_OR_ESCALATION_REQUIRED"
    },
    {
      "class": "M3_HARD_BLOCKER",
      "rank": 3,
      "meaning": "A non-waivable axiom or hard policy blocker prevents continuation.",
      "default_treatment": "BLOCK"
    }
  ],
  "economic_thresholds": [
    {
      "rule_id": "MAT-ECON-001",
      "metric": "FIRM_EBITDA",
      "selectors": {
        "definition_ids": [
          "DEF-EBITDA-FIRM"
        ],
        "model_node_ids": [
          "MN-FIRM-EBITDA"
        ]
      },
      "aggregation": "ANY",
      "authority_change_types": [
        "MATERIAL_EBITDA_TREATMENT"
      ],
      "tests": [
        {
          "basis": "ABSOLUTE_CHANGE",
          "operator": "gte",
          "value": "0.25",
          "unit": "$mm"
        },
        {
          "basis": "RELATIVE_CHANGE_TO_LAST_CURRENT",
          "operator": "gte",
          "value": "0.02",
          "unit": "decimal_ratio"
        }
      ],
      "minimum_class_when_triggered": "M1_PROFESSIONAL_REVIEW"
    },
    {
      "rule_id": "MAT-ECON-002",
      "metric": "SUPPORTED_EV_OR_PRICE_CEILING",
      "selectors": {
        "model_node_ids": [
          "MN-EV"
        ],
        "position_ids": [
          "CP-001"
        ]
      },
      "aggregation": "ANY",
      "authority_change_types": [
        "PRICE"
      ],
      "tests": [
        {
          "basis": "ABSOLUTE_CHANGE",
          "operator": "gte",
          "value": "1.0",
          "unit": "$mm"
        },
        {
          "basis": "RELATIVE_CHANGE_TO_LAST_CURRENT",
          "operator": "gte",
          "value": "0.01",
          "unit": "decimal_ratio"
        }
      ],
      "minimum_class_when_triggered": "M2_GATE_AUTHORITY"
    },
    {
      "rule_id": "MAT-ECON-003",
      "metric": "IRR",
      "selectors": {
        "model_node_id_patterns": [
          "MN-*-IRR"
        ]
      },
      "aggregation": "ANY",
      "tests": [
        {
          "basis": "ABSOLUTE_CHANGE",
          "operator": "gte",
          "value": "0.005",
          "unit": "decimal_rate",
          "display_equivalent": "0.5 percentage points"
        }
      ],
      "minimum_class_when_triggered": "M1_PROFESSIONAL_REVIEW"
    },
    {
      "rule_id": "MAT-ECON-004",
      "metric": "MOIC",
      "selectors": {
        "model_node_id_patterns": [
          "MN-*-MOIC"
        ]
      },
      "aggregation": "ANY",
      "tests": [
        {
          "basis": "ABSOLUTE_CHANGE",
          "operator": "gte",
          "value": "0.05",
          "unit": "x"
        }
      ],
      "minimum_class_when_triggered": "M1_PROFESSIONAL_REVIEW"
    },
    {
      "rule_id": "MAT-ECON-005",
      "metric": "LEVERAGE",
      "selectors": {
        "metric_name_patterns": [
          "*LEVERAGE*"
        ]
      },
      "aggregation": "ANY",
      "authority_change_types": [
        "LEVERAGE"
      ],
      "tests": [
        {
          "basis": "ABSOLUTE_CHANGE",
          "operator": "gte",
          "value": "0.10",
          "unit": "x"
        },
        {
          "basis": "LIMIT_CROSSING",
          "operator": "any_crossing",
          "unit": "x",
          "limit_types": [
            "INTERNAL",
            "LENDER",
            "COVENANT"
          ]
        }
      ],
      "minimum_class_when_triggered": "M2_GATE_AUTHORITY"
    }
  ],
  "epistemic_rules": [
    {
      "rule_id": "MAT-EPI-001",
      "condition": "LAST_SUFFICIENT_NON_CIRCULAR_SUPPORT_ROUTE_LOST",
      "object_filter": {
        "criticality": "critical"
      },
      "minimum_class": "M1_PROFESSIONAL_REVIEW"
    },
    {
      "rule_id": "MAT-EPI-002",
      "condition": "CRITICAL_POSITION_BECOMES_CONTESTED_OR_OPEN",
      "minimum_class": "M1_PROFESSIONAL_REVIEW"
    },
    {
      "rule_id": "MAT-EPI-003",
      "condition": "CRITICAL_POSITION_COVERAGE_INSUFFICIENT",
      "minimum_class": "M1_PROFESSIONAL_REVIEW"
    },
    {
      "rule_id": "MAT-EPI-004",
      "condition": "APPLICABLE_MATERIAL_CONTRADICTION",
      "candidate_epistemic_transition": "CONTESTED",
      "decision_transition": "NONE",
      "minimum_class": "M1_PROFESSIONAL_REVIEW"
    }
  ],
  "gate_and_blocker_rules": [
    {
      "rule_id": "MAT-GATE-001",
      "condition": "CONDITION_PRECEDENT_AFFECTED",
      "minimum_class": "M2_GATE_AUTHORITY"
    },
    {
      "rule_id": "MAT-GATE-002",
      "condition": "RESERVED_AUTHORITY_VERB_AFFECTED",
      "minimum_class": "M2_GATE_AUTHORITY"
    },
    {
      "rule_id": "MAT-GATE-003",
      "condition": "DELEGATED_LIMIT_CROSSED",
      "minimum_class": "M2_GATE_AUTHORITY"
    },
    {
      "rule_id": "MAT-BLOCK-001",
      "condition": "WAIVABLE_HARD_POLICY_BLOCKER",
      "minimum_class": "M3_HARD_BLOCKER",
      "treatment": "BLOCK_UNTIL_EXPLICIT_WAIVER"
    },
    {
      "rule_id": "MAT-BLOCK-002",
      "condition": "NON_WAIVABLE_AXIOM",
      "minimum_class": "M3_HARD_BLOCKER",
      "treatment": "BLOCK_NO_WAIVER"
    }
  ],
  "cumulation": {
    "enabled": true,
    "method": "COMPARE_CANDIDATE_TO_LAST_ABSORBED_CURRENT",
    "protected_output_scope": "EACH_PROTECTED_OUTPUT",
    "not_simple_sum_of_deltas": true,
    "bucket_closes_on": [
      "CURRENT_ADOPTION",
      "NEXT_GATE"
    ],
    "gross_movements_retained_in_audit": true,
    "raw_sub_tolerance_movements_contribute": true,
    "sub_tolerance_treatment": {
      "immediate_downstream_propagation": false,
      "audit_required": true,
      "compare_exact_raw_candidate_to_k_t": true,
      "seed_propagation_when_cumulative_threshold_crosses": true
    }
  },
  "m0_auto_reconciliation_guards": {
    "all_required": true,
    "conditions": [
      "DETERMINISTIC_DERIVED_CHANGE",
      "NO_CASE_POSITION_DECISION_CHANGE",
      "NO_ACCEPTED_ASSUMPTION_CHANGE",
      "NO_RESERVED_DECISION_CHANGE",
      "NO_EXTERNAL_ARTIFACT_COMMITMENT_CHANGE",
      "ALL_INVARIANTS_PASS"
    ],
    "otherwise_minimum_class": "M1_PROFESSIONAL_REVIEW"
  },
  "classification_coverage": {
    "unmatched_delta_class": "M1_PROFESSIONAL_REVIEW",
    "unmatched_rule_id": "KERNEL-MATERIALITY-COVERAGE",
    "m0_safe_harbors": [
      {
        "rule_id": "MAT-M0-001",
        "selectors": {
          "model_node_ids": [
            "M-DERIVED"
          ]
        },
        "fields": [
          "value"
        ],
        "delta_reason_codes": [
          "DIRECT_EVENT_MUTATION"
        ],
        "conditions": [
          "DETERMINISTIC_DERIVED_CHANGE"
        ]
      },
      {
        "rule_id": "MAT-M0-002",
        "selectors": {
          "object_ids": [
            "C-A"
          ]
        },
        "fields": [
          "__lifecycle__"
        ],
        "delta_reason_codes": [
          "DIRECT_EVENT_MUTATION"
        ],
        "conditions": [
          "TARGET_REMAINS_SUPPORTED_BY_ALTERNATIVE_ROUTE"
        ]
      }
    ]
  }
}
