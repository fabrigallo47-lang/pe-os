{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://panta.local/contracts/execution_package.schema.json",
  "title": "PANTA Execution Package",
  "type": "object",
  "properties": {
    "execution_package_id": {
      "type": "string",
      "minLength": 1
    },
    "run_id": {
      "type": "string",
      "minLength": 1
    },
    "candidate_state_id": {
      "type": "string",
      "minLength": 1
    },
    "course_id": {
      "type": "string",
      "minLength": 1
    },
    "authority_record_id": {
      "type": "string",
      "minLength": 1
    },
    "artifact_hash": {
      "type": "string",
      "minLength": 1
    },
    "package_type": {
      "type": "string"
    },
    "destination": {
      "anyOf": [
        {
          "type": "string"
        },
        {
          "type": "null"
        }
      ]
    },
    "sender": {
      "anyOf": [
        {
          "type": "string"
        },
        {
          "type": "null"
        }
      ]
    },
    "subject": {
      "anyOf": [
        {
          "type": "string"
        },
        {
          "type": "null"
        }
      ]
    },
    "message": {
      "anyOf": [
        {
          "type": "string"
        },
        {
          "type": "null"
        }
      ]
    },
    "attachments": {
      "type": "array",
      "items": {
        "type": [
          "string",
          "number",
          "integer",
          "boolean",
          "null",
          "object",
          "array"
        ]
      }
    },
    "checks": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "amount": {
      "type": [
        "string",
        "number",
        "integer",
        "boolean",
        "null",
        "object",
        "array"
      ]
    },
    "currency": {
      "anyOf": [
        {
          "type": "string"
        },
        {
          "type": "null"
        }
      ]
    },
    "document_version": {
      "anyOf": [
        {
          "type": "string"
        },
        {
          "type": "null"
        }
      ]
    },
    "status": {
      "enum": [
        "DRAFT",
        "READY",
        "SENDING",
        "ACCEPTED",
        "REJECTED",
        "FAILED"
      ]
    },
    "created_at": {
      "type": "string",
      "format": "date-time"
    },
    "ack_id": {
      "type": "string"
    },
    "acknowledged_at": {
      "type": "string",
      "format": "date-time"
    },
    "synthetic": {
      "type": "boolean"
    },
    "no_external_effects": {
      "type": "boolean"
    },
    "effective_date": {
      "type": "string",
      "format": "date"
    },
    "known_at": {
      "type": "string",
      "format": "date-time"
    }
  },
  "additionalProperties": true,
  "required": [
    "execution_package_id",
    "run_id",
    "candidate_state_id",
    "course_id",
    "authority_record_id",
    "artifact_hash",
    "status",
    "created_at",
    "effective_date",
    "known_at",
    "synthetic",
    "no_external_effects"
  ]
}
