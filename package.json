{
  "name": "panta-frontend-core-v4",
  "version": "4.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build",
    "typecheck": "tsc --noEmit",
    "preview": "vite preview",
    "fixture-check": "node scripts/check-fixture-free.mjs",
    "syntax-check": "node scripts/syntax-check.mjs",
    "contract-check": "node scripts/contract-check.mjs",
    "validate": "npm run fixture-check && npm run syntax-check && npm run contract-check && npm run kernel-check && npm run dead-control-check && npm run closed-loop-check && npm run behavior-test && npm run projection-test",
    "dead-control-check": "node scripts/no-dead-controls.mjs",
    "closed-loop-check": "node scripts/closed-loop-check.mjs",
    "kernel-check": "node scripts/kernel-alignment-check.mjs",
    "behavior-test": "node tests/behavior-test.mjs",
    "projection-test": "node --no-warnings=ExperimentalWarning --experimental-strip-types tests/projection-behavior.mjs && node --no-warnings=ExperimentalWarning --experimental-strip-types tests/source-evidence.mjs",
    "lab": "vite --config vite.lab.config.ts",
    "lab:build": "vite build --config vite.lab.config.ts",
    "check:all": "npm run validate && npm run typecheck && npm run build && npm run lab:build"
  },
  "dependencies": {
    "react": "^18.3.1",
    "react-dom": "^18.3.1"
  },
  "devDependencies": {
    "@types/react": "^18.3.12",
    "@types/react-dom": "^18.3.1",
    "@vitejs/plugin-react": "^4.3.4",
    "typescript": "^5.8.3",
    "vite": "^6.0.7"
  },
  "engines": {
    "node": ">=22"
  }
}
