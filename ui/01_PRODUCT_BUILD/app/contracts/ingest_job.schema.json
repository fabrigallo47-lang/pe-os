{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://panta.local/contracts/ingest_job.schema.json",
  "title": "PANTA Ingest Job",
  "type": "object",
  "properties": {
    "job_id": {
      "type": "string",
      "minLength": 1
    },
    "case_id": {
      "type": "string"
    },
    "status": {
      "enum": [
        "QUEUED",
        "PARSING",
        "EXTRACTING",
        "BINDING",
        "VALIDATING",
        "COMPLETE",
        "FAILED",
        "CANCELLED"
      ]
    },
    "stage": {
      "type": "string",
      "minLength": 1
    },
    "stage_label": {
      "type": "string"
    },
    "progress": {
      "type": "number",
      "minimum": 0,
      "maximum": 100
    },
    "created_at": {
      "type": "string",
      "format": "date-time"
    },
    "completed_at": {
      "type": "string",
      "format": "date-time"
    },
    "source_name": {
      "type": "string",
      "minLength": 1
    },
    "file_name": {
      "anyOf": [
        {
          "type": "string"
        },
        {
          "type": "null"
        }
      ]
    },
    "method": {
      "anyOf": [
        {
          "type": "string"
        },
        {
          "type": "null"
        }
      ]
    },
    "purpose": {
      "anyOf": [
        {
          "type": "string"
        },
        {
          "type": "null"
        }
      ]
    },
    "message": {
      "type": "string"
    },
    "source_id": {
      "type": "string"
    },
    "version_id": {
      "type": "string"
    },
    "claim_ids": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "effective_date": {
      "type": "string",
      "format": "date"
    },
    "known_at": {
      "type": "string",
      "format": "date-time"
    }
  },
  "additionalProperties": true,
  "required": [
    "job_id",
    "status",
    "stage",
    "progress",
    "created_at",
    "source_name",
    "effective_date",
    "known_at"
  ]
}
