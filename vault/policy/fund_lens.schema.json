{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://panta.local/schemas/fund_lens.schema.json",
  "title": "PANTA Fund Lens",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "lens_id",
    "version",
    "label",
    "description",
    "archetype",
    "binding_profile",
    "effective_date",
    "questions"
  ],
  "properties": {
    "schema_version": {"const": "fund-lens/1.0"},
    "lens_id": {"type": "string", "pattern": "^[A-Za-z0-9._-]+$"},
    "version": {"type": "string", "pattern": "^[0-9]+\\.[0-9]+\\.[0-9]+$"},
    "label": {"type": "string", "minLength": 1},
    "description": {"type": "string"},
    "archetype": {"type": "string", "minLength": 1},
    "binding_profile": {"const": "keystone-e3-v1"},
    "effective_date": {"type": "string", "format": "date"},
    "questions": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["id", "version", "workstream", "title"],
        "properties": {
          "id": {"type": "string", "pattern": "^[A-Za-z0-9._:-]+$"},
          "version": {"type": "integer", "minimum": 1},
          "workstream": {"type": "string", "minLength": 1},
          "title": {"type": "string", "minLength": 1}
        }
      }
    }
  }
}
