{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://panta.example/schemas/state-transition-event-1.0.json",
  "title": "PANTA State Transition Event",
  "description": "Runtime event envelope. This schema does not extend the Canonical Investment Case ontology.",
  "type": "object",
  "required": [
    "event_id",
    "event",
    "effective_date",
    "known_at",
    "source_ids",
    "trigger_claim_ids",
    "mutations"
  ],
  "properties": {
    "event_id": {
      "type": "string",
      "minLength": 1
    },
    "batch_id": {
      "type": "string",
      "minLength": 1
    },
    "event": {
      "type": "string",
      "minLength": 1
    },
    "effective_date": {
      "type": "string",
      "format": "date"
    },
    "known_at": {
      "type": "string",
      "format": "date-time"
    },
    "source_ids": {
      "type": "array",
      "items": {
        "type": "string"
      },
      "uniqueItems": true
    },
    "trigger_claim_ids": {
      "type": "array",
      "items": {
        "type": "string"
      },
      "uniqueItems": true
    },
    "mutations": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/mutation"
      }
    }
  },
  "$defs": {
    "mutation": {
      "type": "object",
      "required": [
        "operation",
        "object_type",
        "object_id"
      ],
      "properties": {
        "operation": {
          "enum": [
            "ADD",
            "OBSERVE",
            "CORRECT",
            "SUPERSEDE",
            "RETRACT"
          ]
        },
        "object_type": {
          "enum": [
            "CLAIM",
            "POSITION",
            "MODEL_NODE",
            "SUPPORT_ROUTE",
            "ARTIFACT"
          ]
        },
        "object_id": {
          "type": "string",
          "minLength": 1
        },
        "field": {
          "type": "string"
        },
        "from": {},
        "to": {},
        "unit": {
          "type": [
            "string",
            "null"
          ]
        },
        "definition_id": {
          "type": [
            "string",
            "null"
          ]
        },
        "period": {
          "type": [
            "string",
            "null"
          ]
        },
        "perimeter": {
          "type": [
            "string",
            "null"
          ]
        },
        "supersedes_object_version": {
          "type": [
            "string",
            "null"
          ]
        }
      },
      "additionalProperties": true
    }
  },
  "additionalProperties": true
}
