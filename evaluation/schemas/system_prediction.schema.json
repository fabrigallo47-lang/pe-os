{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://panta.local/evaluation/system_prediction.schema.json",
  "title": "PANTA Evaluation System Prediction",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "test_id", "status"],
  "properties": {
    "schema_version": {"const": "panta-eval.prediction/1.0"},
    "test_id": {"type": "string", "minLength": 1},
    "status": {"enum": ["success", "abstained", "unsupported", "error"]},
    "answer": {},
    "content": {"type": "string"},
    "fields": {"type": "array", "items": {"type": "object", "additionalProperties": true}},
    "facts": {"type": "array", "items": {"type": "object", "additionalProperties": true}},
    "elements": {"type": "array", "items": {"type": "object", "additionalProperties": true}},
    "media": {"type": "array", "items": {"type": "object", "additionalProperties": true}},
    "evidence": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["input_id", "locator"],
        "properties": {
          "input_id": {"type": "string"},
          "locator": {"$ref": "https://panta.local/evaluation/evidence_locator.schema.json"},
          "quote": {"type": "string"},
          "role": {"enum": ["answer", "supporting", "contradicting", "context"]}
        }
      }
    },
    "confidence": {"type": "number", "minimum": 0, "maximum": 1},
    "latency_ms": {"type": "number", "minimum": 0},
    "cost": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "amount": {"type": "number", "minimum": 0},
        "currency": {"type": "string", "minLength": 3, "maxLength": 3}
      },
      "required": ["amount", "currency"]
    },
    "system": {
      "type": "object",
      "additionalProperties": true,
      "properties": {
        "name": {"type": "string"},
        "version": {"type": "string"},
        "model": {"type": "string"}
      }
    },
    "native_scores": {
      "type": "object",
      "additionalProperties": {"type": "number"}
    },
    "error": {"type": ["string", "null"]},
    "metadata": {"type": "object", "additionalProperties": true}
  }
}
