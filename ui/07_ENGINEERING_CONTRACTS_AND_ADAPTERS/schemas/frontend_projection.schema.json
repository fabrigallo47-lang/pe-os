            "unknowns": {
              "type": "object",
              "properties": {},
              "additionalProperties": true
            },
            "shadowIC": {
              "type": "object",
              "properties": {},
              "additionalProperties": true
            }
          },
          "additionalProperties": true,
          "required": [
            "foundations",
            "unknowns",
            "shadowIC"
          ]
