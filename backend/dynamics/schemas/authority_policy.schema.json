{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://panta.example/schemas/authority-policy-1.0.json",
  "title": "PANTA Runtime Authority Policy",
  "description": "Versioned authority-routing input contract. Routing tags select a rule but never constitute an authority act.",
  "type": "object",
  "required": [
    "schema_version",
    "policy_id",
    "version",
    "kernel_rules",
    "rule_resolution",
    "unresolved_routing",
    "rules"
  ],
  "properties": {
    "schema_version": {
      "const": "runtime-policy-1.0"
    },
    "policy_id": {
      "type": "string",
      "minLength": 1
    },
    "version": {
      "type": "string",
      "minLength": 1
    },
    "kernel_rules": {
      "type": "object"
    },
    "rule_resolution": {
      "type": "object",
      "required": [
        "mode",
        "class_order",
        "deny_or_block_overrides_permission",
        "escalation_required_when_delegation_unproven"
      ],
      "properties": {
        "mode": {
          "const": "MOST_RESTRICTIVE_MATCH"
        },
        "class_order": {
          "type": "array",
          "minItems": 4,
          "maxItems": 4,
          "prefixItems": [
            {
              "const": "M0_LOCAL"
            },
            {
              "const": "M1_PROFESSIONAL_REVIEW"
            },
            {
              "const": "M2_GATE_AUTHORITY"
            },
            {
              "const": "M3_HARD_BLOCKER"
            }
          ],
          "items": false,
          "uniqueItems": true
        },
        "deny_or_block_overrides_permission": {
          "const": true
        },
        "escalation_required_when_delegation_unproven": {
          "const": true
        }
      },
      "additionalProperties": true
    },
    "unresolved_routing": {
      "type": "object",
      "required": [
        "reason_code",
        "required_role",
        "policy_rule_id"
      ],
      "properties": {
        "reason_code": {
          "type": "string",
          "minLength": 1
        },
        "required_role": {
          "type": "string",
          "minLength": 1
        },
        "policy_rule_id": {
          "type": "string",
          "minLength": 1
        }
      },
      "additionalProperties": false
    },
    "rules": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": {
        "$ref": "#/$defs/authority_rule"
      }
    }
  },
  "$defs": {
    "materiality_class": {
      "enum": [
        "M0_LOCAL",
        "M1_PROFESSIONAL_REVIEW",
        "M2_GATE_AUTHORITY",
        "M3_HARD_BLOCKER"
      ]
    },
    "unique_string_array": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "string",
        "minLength": 1
      },
      "uniqueItems": true
    },
    "when": {
      "type": "object",
      "minProperties": 1,
      "properties": {
        "materiality_classes": {
          "type": "array",
          "minItems": 1,
          "items": {
            "$ref": "#/$defs/materiality_class"
          },
          "uniqueItems": true
        },
        "maximum_materiality_class": {
          "$ref": "#/$defs/materiality_class"
        },
        "change_types": {
          "$ref": "#/$defs/unique_string_array"
        },
        "all_conditions": {
          "$ref": "#/$defs/unique_string_array"
        },
        "any_conditions": {
          "$ref": "#/$defs/unique_string_array"
        }
      },
      "additionalProperties": false
    },
    "current_adoption": {
      "type": "object",
      "required": [
        "mode"
      ],
      "properties": {
        "mode": {
          "enum": [
            "AUTOMATIC_RECONCILIATION",
            "HUMAN",
            "REGISTER_FACT_ONLY",
            "RECOMMENDATION",
            "ARTIFACT_APPLICATION_REVIEW"
          ]
        },
        "required_role": {
          "type": [
            "string",
            "null"
          ]
        },
        "independence_required": {
          "type": "boolean"
        },
        "adopter_actor_must_differ_from_preparer_actor": {
          "type": "boolean"
        }
      },
      "additionalProperties": true
    },
    "approved_action": {
      "type": "object",
      "required": [
        "mode"
      ],
      "properties": {
        "mode": {
          "enum": [
            "NONE",
            "UNCHANGED",
            "NONE_UNLESS_RESERVED_DECISION_CHANGES",
            "CONDITIONAL",
            "HUMAN",
            "WAIVER_IF_POLICY_ALLOWS",
            "EXTERNAL_ACTION_POLICY"
          ]
        },
        "required_role": {
          "type": "string",
          "minLength": 1
        },
        "required_role_when_triggered": {
          "type": "string",
          "minLength": 1
        },
        "required_role_within_delegation": {
          "type": "string",
          "minLength": 1
        },
        "required_role_beyond_delegation": {
          "type": "string",
          "minLength": 1
        },
        "waivable_policy_breach_role": {
          "type": "string",
          "minLength": 1
        },
        "trigger_conditions": {
          "$ref": "#/$defs/unique_string_array"
        }
      },
      "additionalProperties": true
    },
    "authority_rule": {
      "type": "object",
      "required": [
        "rule_id",
        "priority",
        "when",
        "current_adoption",
        "approved_action"
      ],
      "properties": {
        "rule_id": {
          "type": "string",
          "minLength": 1
        },
        "priority": {
          "type": "integer",
          "minimum": 0,
          "description": "Higher values are more restrictive and win MOST_RESTRICTIVE_MATCH. Equal highest matching priorities are ambiguous."
        },
        "when": {
          "$ref": "#/$defs/when"
        },
        "preparer_roles": {
          "$ref": "#/$defs/unique_string_array"
        },
        "current_adoption": {
          "$ref": "#/$defs/current_adoption"
        },
        "approved_action": {
          "$ref": "#/$defs/approved_action"
        },
        "escalation": {
          "type": [
            "object",
            "null"
          ]
        }
      },
      "additionalProperties": true
    }
  },
  "additionalProperties": true
}
