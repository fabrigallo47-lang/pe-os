{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://panta.local/evaluation/evaluation_case.schema.json",
  "title": "PANTA Evaluation Case",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "test_id", "benchmark", "split", "task", "inputs", "gold", "metrics"],
  "properties": {
    "schema_version": {"const": "panta-eval.case/1.0"},
    "test_id": {"type": "string", "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]*$"},
    "benchmark": {"$ref": "#/$defs/benchmark"},
    "split": {"enum": ["train", "dev", "validation", "public_test", "private_test", "challenge", "smoke"]},
    "task": {"$ref": "#/$defs/task"},
    "inputs": {
      "type": "array",
      "minItems": 1,
      "items": {"$ref": "#/$defs/input"}
    },
    "query": {"type": ["string", "null"]},
    "evaluation_profile": {
      "enum": ["schema_strict", "information_graph", "semantic_claim_graph", "layout_fidelity", "full"]
    },
    "gold": {"$ref": "#/$defs/gold"},
    "evidence": {
      "type": "array",
      "items": {"$ref": "#/$defs/evidence"}
    },
    "metrics": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": {"type": "string", "minLength": 1}
    },
    "diagnostic_metrics": {
      "type": "array",
      "uniqueItems": true,
      "items": {"type": "string", "minLength": 1}
    },
    "acceptance": {"$ref": "#/$defs/acceptance"},
    "tags": {
      "type": "array",
      "uniqueItems": true,
      "items": {"type": "string", "minLength": 1}
    },
    "weight": {"type": "number", "exclusiveMinimum": 0},
    "license": {"type": "string"},
    "notes": {"type": "string"}
  },
  "$defs": {
    "benchmark": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "version", "original_id"],
      "properties": {
        "id": {"type": "string", "minLength": 1},
        "version": {"type": "string", "minLength": 1},
        "original_id": {"type": "string", "minLength": 1},
        "track": {"type": "string"},
        "source_uri": {"type": "string"}
      }
    },
    "task": {
      "enum": [
        "parsing", "document_parsing", "text_extraction", "layout_extraction",
        "field_extraction", "table_extraction", "image_detection", "image_ocr",
        "chart_extraction", "diagram_understanding", "semantic_qa", "visual_qa",
        "mixed_qa", "cross_document_qa", "summarization",
        "spreadsheet_manipulation", "semantic_claim_extraction", "grounding", "abstention", "robustness"
      ]
    },
    "format": {
      "enum": [
        "pdf", "pdf_page", "doc", "docx", "docm", "rtf", "ppt", "pptx", "pptm",
        "xls", "xlsx", "xlsm", "csv", "tsv", "msg", "pst", "ost", "eml", "mbox",
        "png", "jpeg", "tiff", "bmp", "webp", "gif", "svg", "emf", "wmf", "heic", "jp2", "html", "txt", "md",
        "json", "slide_images", "email_thread", "bundle", "other"
      ]
    },
    "input": {
      "type": "object",
      "additionalProperties": false,
      "required": ["input_id", "family", "format", "role"],
      "properties": {
        "input_id": {"type": "string", "minLength": 1},
        "family": {"enum": ["document", "presentation", "spreadsheet", "email", "image", "multimodal", "other"]},
        "format": {"$ref": "#/$defs/format"},
        "path": {"type": "string", "minLength": 1},
        "uri": {"type": "string", "minLength": 1},
        "role": {"enum": ["primary", "attachment", "embedded", "reference", "rendered_page"]},
        "parent_input_id": {"type": "string"},
        "mime_type": {"type": "string"},
        "sha256": {"type": "string", "pattern": "^[a-fA-F0-9]{64}$"},
        "selector": {"type": "object", "additionalProperties": true},
        "metadata": {"type": "object", "additionalProperties": true}
      },
      "anyOf": [{"required": ["path"]}, {"required": ["uri"]}]
    },
    "field": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "field_type": {"type": "string"},
        "name": {"type": "string"},
        "fact_id": {"type": "string"},
        "concept_id": {"type": "string"},
        "subject": {"type": "string"},
        "predicate": {"type": "string"},
        "aliases": {
          "type": "array",
          "uniqueItems": true,
          "items": {"type": "string", "minLength": 1}
        },
        "value": {},
        "text": {"type": ["string", "null"]},
        "unit": {"type": ["string", "null"]},
        "qualifiers": {"type": "object", "additionalProperties": true},
        "line_item_id": {"type": ["integer", "string", "null"]},
        "confidence": {"type": "number", "minimum": 0, "maximum": 1},
        "input_id": {"type": "string"},
        "locator": {"$ref": "https://panta.local/evaluation/evidence_locator.schema.json"}
      },
      "anyOf": [
        {"required": ["field_type"]}, {"required": ["name"]},
        {"required": ["fact_id"]}, {"required": ["concept_id"]},
        {"required": ["predicate"]}
      ]
    },
    "element": {
      "type": "object",
      "additionalProperties": false,
      "required": ["type"],
      "properties": {
        "type": {"type": "string", "minLength": 1},
        "text": {"type": ["string", "null"]},
        "html": {"type": ["string", "null"]},
        "latex": {"type": ["string", "null"]},
        "order": {"type": "integer", "minimum": 0},
        "input_id": {"type": "string"},
        "locator": {"$ref": "https://panta.local/evaluation/evidence_locator.schema.json"},
        "metadata": {"type": "object", "additionalProperties": true}
      }
    },
    "semantic_claim": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "claim_id", "statement", "source_id", "input_id", "locator",
        "entity", "metric", "measurement", "value", "unit", "bound",
        "period_canonical", "scope", "basis", "scenario",
        "epistemic_class", "claim_kind"
      ],
      "properties": {
        "claim_id": {"type": "string", "minLength": 1},
        "statement": {"type": "string", "minLength": 1},
        "source_id": {"type": "string", "minLength": 1},
        "input_id": {"type": "string", "minLength": 1},
        "locator": {"$ref": "https://panta.local/evaluation/evidence_locator.schema.json"},
        "source_quote": {"type": "string"},
        "entity": {"type": "string", "minLength": 1},
        "metric": {"type": "string", "minLength": 1},
        "measurement": {"type": "string", "minLength": 1},
        "value": {},
        "unit": {"type": ["string", "null"]},
        "bound": {"enum": ["EXACT", "AT_LEAST", "AT_MOST", "APPROXIMATE", "RANGE", "NONE"]},
        "period": {"type": ["string", "null"]},
        "period_canonical": {"type": "string", "minLength": 1},
        "scope": {"enum": ["consolidated", "standalone", "customer", "segment", "unspecified"]},
        "basis": {"enum": ["SellerView", "QoEView", "FirmView", "CovenantView", "ReportedView", "unspecified"]},
        "scenario": {"enum": ["base", "management", "seller", "upside", "downside", "unspecified"]},
        "epistemic_class": {"enum": ["asserted", "observed", "derived", "attested", "institutional_act"]},
        "claim_kind": {"enum": ["QUANTITATIVE", "DEFINITION", "CONDITION", "ATTRIBUTION", "NEGATIVE"]},
        "definition_id": {"type": ["string", "null"]},
        "direction": {"enum": ["supports", "contradicts", "context"]},
        "known_at": {"type": ["string", "null"], "format": "date-time"},
        "effective_date": {"type": ["string", "null"]},
        "criticality": {"enum": ["decision_critical", "material", "contextual"]},
        "derivation": {
          "type": ["object", "null"],
          "additionalProperties": false,
          "required": ["expression", "operand_claim_ids"],
          "properties": {
            "expression": {"type": ["string", "null"]},
            "operand_claim_ids": {
              "type": "array",
              "uniqueItems": true,
              "items": {"type": "string", "minLength": 1}
            }
          }
        }
      }
    },
    "semantic_relation": {
      "type": "object",
      "additionalProperties": false,
      "required": ["source_claim_id", "relation", "target_type", "target_id"],
      "properties": {
        "source_claim_id": {"type": "string", "minLength": 1},
        "relation": {"type": "string", "minLength": 1},
        "target_type": {"enum": ["claim", "question", "definition", "position"]},
        "target_id": {"type": "string", "minLength": 1}
      }
    },
    "no_claim_span": {
      "type": "object",
      "additionalProperties": false,
      "required": ["input_id", "locator", "quote", "reason"],
      "properties": {
        "input_id": {"type": "string", "minLength": 1},
        "locator": {"$ref": "https://panta.local/evaluation/evidence_locator.schema.json"},
        "quote": {"type": "string", "minLength": 1},
        "reason": {"type": "string", "minLength": 1}
      }
    },
    "assertion": {
      "oneOf": [
        {"type": "string", "minLength": 1},
        {
          "type": "object",
          "additionalProperties": false,
          "required": ["text"],
          "properties": {
            "id": {"type": "string"},
            "text": {"type": "string", "minLength": 1},
            "weight": {"type": "number", "exclusiveMinimum": 0},
            "critical": {"type": "boolean"}
          }
        }
      ]
    },
    "gold": {
      "type": "object",
      "additionalProperties": false,
      "minProperties": 1,
      "properties": {
        "answer": {},
        "answers": {"type": "array", "items": {}},
        "assertions": {"type": "array", "items": {"$ref": "#/$defs/assertion"}},
        "fields": {"type": "array", "items": {"$ref": "#/$defs/field"}},
        "facts": {"type": "array", "items": {"$ref": "#/$defs/field"}},
        "claims": {"type": "array", "items": {"$ref": "#/$defs/semantic_claim"}},
        "relations": {"type": "array", "items": {"$ref": "#/$defs/semantic_relation"}},
        "no_claim_spans": {"type": "array", "items": {"$ref": "#/$defs/no_claim_span"}},
        "as_of_known_at": {"type": "string", "format": "date-time"},
        "coverage": {"enum": ["subset", "exhaustive"]},
        "content": {"type": "string"},
        "elements": {"type": "array", "items": {"$ref": "#/$defs/element"}},
        "structure": {"type": "object", "additionalProperties": true},
        "media": {"type": "array", "items": {"type": "object", "additionalProperties": true}},
        "expected_status": {"enum": ["success", "abstained", "unsupported", "error"]},
        "unanswerable": {"type": "boolean"},
        "native": {"type": "object", "additionalProperties": true}
      }
    },
    "evidence": {
      "type": "object",
      "additionalProperties": false,
      "required": ["input_id", "locator"],
      "properties": {
        "input_id": {"type": "string", "minLength": 1},
        "locator": {"$ref": "https://panta.local/evaluation/evidence_locator.schema.json"},
        "quote": {"type": "string"},
        "role": {"enum": ["answer", "supporting", "contradicting", "context"]}
      }
    },
    "acceptance": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "min_score": {"type": "number", "minimum": 0, "maximum": 1},
        "required_metrics": {"type": "array", "items": {"type": "string"}},
        "max_latency_ms": {"type": "number", "minimum": 0},
        "critical": {"type": "boolean"}
      }
    }
  }
}
