{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://panta.local/contracts/transition_result.schema.json",
  "title": "PANTA Frozen Engine Output + Frontend Transition Projection (19 integration fields)",
  "type": "object",
  "properties": {
    "schema_version": {
      "type": "string",
      "minLength": 1
    },
    "engine_version": {
      "type": "string",
      "minLength": 1
    },
    "run_id": {
      "type": "string",
      "minLength": 1
    },
    "case_id": {
      "type": "string",
      "minLength": 1
    },
    "prior_state_id": {
      "type": "string",
      "minLength": 1
    },
    "source_event_id": {
      "type": "string",
      "minLength": 1
    },
    "policy_refs": {
      "type": "object",
      "properties": {
        "materiality_policy_id": {
          "type": "string",
          "minLength": 1
        },
        "authority_policy_id": {
          "type": "string",
          "minLength": 1
        },
        "canonical_graph_hash": {
          "type": "string",
          "minLength": 1
        },
        "execution_mapping_hash": {
          "type": "string",
          "minLength": 1
        },
        "solver_config_hash": {
          "type": "string",
          "minLength": 1
        }
      },
      "additionalProperties": true,
      "required": [
        "materiality_policy_id",
        "authority_policy_id",
        "canonical_graph_hash",
        "execution_mapping_hash",
        "solver_config_hash"
      ]
    },
    "affected_set": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "order": {
            "type": "integer",
            "minimum": 0
          },
          "object_id": {
            "type": "string",
            "minLength": 1
          },
          "label": {
            "type": "string",
            "minLength": 1
          },
          "disposition": {
            "type": "string",
            "minLength": 1
          },
          "before": {
            "type": [
              "string",
              "number",
              "integer",
              "boolean",
              "null",
              "object",
              "array"
            ]
          },
          "after": {
            "type": [
              "string",
              "number",
              "integer",
              "boolean",
              "null",
              "object",
              "array"
            ]
          },
          "explanation": {
            "type": "string"
          },
          "source_trace": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ]
          }
        },
        "additionalProperties": true,
        "required": [
          "order",
          "object_id",
          "label",
          "disposition",
          "before",
          "after",
          "explanation"
        ]
      }
    },
    "ordered_transitions": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "order": {
            "type": "integer",
            "minimum": 0
          },
          "component_id": {
            "type": "string",
            "minLength": 1
          },
          "component_type": {
            "enum": [
              "ACYCLIC",
              "CYCLIC",
              "SCC",
              "BLOCKED"
            ]
          },
          "member_ids": {
            "type": "array",
            "items": {
              "type": "string",
              "minLength": 1
            }
          },
          "result": {
            "type": "string",
            "minLength": 1
          }
        },
        "additionalProperties": true,
        "required": [
          "order",
          "component_id",
          "component_type",
          "member_ids",
          "result"
        ]
      }
    },
    "rule_switches": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {},
        "additionalProperties": true
      }
    },
    "recomputed_values": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {},
        "additionalProperties": true
      }
    },
    "unchanged_objects": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {},
        "additionalProperties": true
      }
    },
    "human_stops": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "stop_id": {
            "type": "string",
            "minLength": 1
          },
          "object_id": {
            "type": "string",
            "minLength": 1
          },
          "component_id": {
            "type": "string"
          },
          "reason_code": {
            "type": "string",
            "minLength": 1
          },
          "requested_action": {
            "type": "string"
          },
          "required_role": {
            "type": "string",
            "minLength": 1
          },
          "required_authority_level": {
            "type": "string",
            "minLength": 1
          },
          "policy_rule_id": {
            "type": "string"
          },
          "downstream_scope": {
            "type": "array",
            "items": {
              "type": "string"
            }
          },
          "authority_verb": {
            "type": "string",
            "minLength": 1
          },
          "reason": {
            "type": "string",
            "minLength": 1
          },
          "status": {
            "enum": [
              "OPEN",
              "CLOSED",
              "EXPIRED"
            ]
          },
          "attestable": {
            "type": "boolean"
          },
          "resolution_kind": {
            "enum": [
              "AUTHORITY_ATTESTATION",
              "INPUT_OR_MODEL_CORRECTION",
              "NON_WAIVABLE_BLOCK",
              "POLICY_CORRECTION"
            ]
          }
        },
        "additionalProperties": true,
        "required": [
          "stop_id",
          "object_id",
          "reason_code",
          "required_role",
          "required_authority_level",
          "authority_verb",
          "reason",
          "status"
        ]
      }
    },
    "blocked_components": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "component_id": {
            "type": "string",
            "minLength": 1
          },
          "member_ids": {
            "type": "array",
            "items": {
              "type": "string"
            }
          },
          "reason_code": {
            "type": "string",
            "minLength": 1
          },
          "reason": {
            "type": "string",
            "minLength": 1
          },
          "downstream_scope": {
            "type": "array",
            "items": {
              "type": "string"
            }
          },
          "resolvable_by": {
            "type": "string"
          },
          "status": {
            "enum": [
              "BLOCKED",
              "RESOLVED"
            ]
          }
        },
        "additionalProperties": true,
        "required": [
          "component_id",
          "member_ids",
          "reason_code",
          "reason",
          "downstream_scope",
          "status"
        ]
      }
    },
    "coverage_limits": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "limit_id": {
            "type": "string",
            "minLength": 1
          },
          "reason_code": {
            "type": "string"
          },
          "label": {
            "type": "string"
          },
          "effect": {
            "type": "string"
          }
        },
        "additionalProperties": true,
        "required": [
          "limit_id"
        ]
      }
    },
    "invariant_checks": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "check_id": {
            "type": "string",
            "minLength": 1
